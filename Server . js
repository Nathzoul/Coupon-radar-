const { Client, LocalAuth } = require('whatsapp-web.js');
const qrcode = require('qrcode-terminal');
const express = require('express');
const app = express();
const PORT = process.env.PORT || 3000;

let latestCoupons = [];
let qrCodeValue = null;

// Initialisation du Robot WhatsApp
const client = new Client({
    authStrategy: new LocalAuth(),
    puppeteer: {
        args: ['--no-sandbox', '--disable-setuid-sandbox']
    }
});

// Génération du QR Code dans le système
client.on('qr', (qr) => {
    qrCodeValue = qr;
    qrcode.generate(qr, { small: true });
    console.log('Nouveau QR Code généré. Prêt à être scanné !');
});

client.on('ready', () => {
    console.log('Le Robot WhatsApp est officiellement VIVANT et connecté !');
    qrCodeValue = "CONNECTED";
});

// ÉCOUTE ET EXTRACTION DES VRAIS COUPONS EN TEMPS RÉEL
client.on('message', async (msg) => {
    try {
        const chat = await msg.getChat();
        
        // Vérification si le message provient des pronostiqueurs cibles
        const sourceName = chat.name ? chat.name.toLowerCase() : "";
        if (sourceName.includes("boss rema") || sourceName.includes("new york live")) {
            
            const text = msg.body;
            // Expression régulière béton pour attraper les codes (5 à 8 caractères majuscules/chiffres)
            const codeRegex = /\b[A-Z0-9]{5,8}\b/g;
            const matches = text.match(codeRegex);

            if (matches) {
                matches.forEach(code => {
                    // Éviter les faux positifs (mots courants en majuscules)
                    if (isNaN(code) && !["1XBET", "BONUS", "PARIS", "TELEGRAM", "WHATSAPP"].includes(code)) {
                        
                        // Détection automatique du pays mentionné dans le texte
                        let pays = "Général";
                        if (text.toLowerCase().includes("cameroun")) pays = "Cameroun";
                        if (text.toLowerCase().includes("ivoire") || text.toLowerCase().includes("rci")) pays = "Côte d'Ivoire";
                        if (text.toLowerCase().includes("bénin")) pays = "Bénin";

                        const nouveauCoupon = {
                            id: Date.now() + Math.random().toString(36).substr(2, 5),
                            pronostiqueur: chat.name,
                            code: code,
                            pays: pays,
                            date: new Date().toLocaleString("fr-FR", { timeZone: "Africa/Porto-Novo" })
                        };

                        latestCoupons.unshift(nouveauCoupon);
                        // Garder seulement les 50 derniers coupons en mémoire
                        if (latestCoupons.length > 50) latestCoupons.pop();
                        
                        console.log(`[SUCCÈS] Vrai coupon extrait : ${code} pour le pays : ${pays}`);
                    }
                });
            }
        }
    } catch (err) {
        console.error("Erreur lors du traitement du message :", err);
    }
});

// INTERFACE WEB POUR TOI ET TES UTILISATEURS
app.use(express.json());

app.get('/', (req, res) => {
    let html = `
    <!DOCTYPE html>
    <html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>CouponRadar Pro</title>
        <script src="https://tailwindcss.com"></script>
    </head>
    <body class="bg-gray-900 text-white min-h-screen font-sans">
        <header class="bg-gray-800 p-4 shadow-md flex justify-between items-center border-b border-yellow-500">
            <h1 class="text-xl font-bold text-yellow-500 tracking-wider">🎯 COUPON RADAR v1.0</h1>
            <div class="text-xs bg-green-600 px-3 py-1 rounded-full font-semibold animate-pulse">SERVEUR ACTIF</div>
        </header>
        <main class="p-4 max-w-xl mx-auto">
            <!-- Section Connexion WhatsApp Admin -->
            <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 mb-6 shadow-xl">
                <h2 class="text-sm font-semibold uppercase text-gray-400 mb-3">🛠️ Liaison WhatsApp (Statut)</h2>
                <div id="status-box" class="p-3 bg-gray-900 rounded-lg text-center font-mono text-sm text-yellow-400">
                    Chargement du flux d'activation...
                </div>
            </div>
            <!-- Section Liste des Coupons -->
            <h2 class="text-lg font-bold mb-4 flex items-center">⚡ Vrais Coupons Capturés</h2>
            <div id="coupons-container" class="space-y-4">
                <p class="text-gray-500 text-center py-8">En attente de nouveaux coupons en temps réel de Boss Rema...</p>
            </div>
        </main>
        <script>
            async function updateDashboard() {
                try {
                    const res = await fetch('/api/data');
                    const data = await res.json();
                    
                    // Gestion de l'affichage du QR Code
                    const statusBox = document.getElementById('status-box');
                    if(data.status === "CONNECTED") {
                        statusBox.innerHTML = "<span class='text-green-400 font-bold'>✅ ROBOT LIÉ ET EN ÉCOUTE ACTIVE</span>";
                    } else if(data.qr) {
                        statusBox.innerHTML = \`<p class='text-white mb-2 text-xs'>Scanne ce code avec ton WhatsApp de test :</p>
                        <img class='mx-auto bg-white p-2 rounded' src='https://qrserver.com\${encodeURIComponent(data.qr)}' />\`;
                    } else {
                        statusBox.innerHTML = "⏳ Initialisation du moteur WhatsApp... Patientez.";
                    }

                    // Gestion de l'affichage des coupons
                    const container = document.getElementById('coupons-container');
                    if(data.coupons.length > 0) {
                        container.innerHTML = data.coupons.map(c => \`
                            <div class="bg-gray-800 border-l-4 border-yellow-500 p-4 rounded-r-xl shadow-md">
                                <div class="flex justify-between items-start mb-2">
                                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">\${c.pronostiqueur}</span>
                                    <span class="text-xs bg-yellow-500 text-black px-2 py-0.5 rounded font-bold">\${c.pays}</span>
                                </div>
                                <div class="flex justify-between items-center bg-gray-900 p-3 rounded-lg border border-gray-700">
                                    <span class="text-2xl font-mono font-black text-white tracking-widest">\${c.code}</span>
                                    <button onclick="navigator.clipboard.writeText('\${c.code}'); alert('Code copié !');" class="bg-yellow-500 hover:bg-yellow-600 text-black px-3 py-1.5 rounded-lg text-xs font-bold transition-all uppercase">Copier</button>
                                </div>
                                <div class="mt-3 flex justify-between items-center text-[10px] text-gray-500">
                                    <span>🕒 Capturé le : \${c.date}</span>
                                    <a href="https://1xbet.bj" target="_blank" class="text-yellow-500 font-semibold underline hover:text-yellow-400">➡️ Parier sur 1xBet (Lien Affilié)</a>
                                </div>
                            </div>
                        \`).join('');
                    }
                } catch(e) { console.error(e); }
            }
            setInterval(updateDashboard, 3000);
            updateDashboard();
        </script>
    </body>
    </html>
    `;
    res.send(html);
});

app.get('/api/data', (req, res) => {
    res.json({ qr: qrCodeValue, status: qrCodeValue === "CONNECTED" ? "CONNECTED" : "DISCONNECTED", coupons: latestCoupons });
});

client.initialize();
app.listen(PORT, () => console.log(`Serveur Web démarré sur le port ${PORT}`));
